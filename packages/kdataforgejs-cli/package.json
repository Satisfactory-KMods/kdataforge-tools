{
	"name": "@sf-kmods/kdataforgejs-cli",
	"version": "9999.9.9",
	"description": "kdf - create, type-check and validate KDataForge projects with KDataForgeJS (TypeScript) scripts.",
	"license": "MIT",
	"author": "Kyri123/Kyrium",
	"homepage": "https://docs.k-mods.com/kdataforge/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Satisfactory-KMods/kdataforge-tools.git",
		"directory": "packages/kdataforgejs-cli"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"kdataforge",
		"satisfactory",
		"modding",
		"cli"
	],
	"type": "module",
	"bin": {
		"kdf": "dist/bin.js",
		"kdataforgejs": "dist/bin.js",
		"kdataforgejs-cli": "dist/bin.js"
	},
	"files": [
		"dist",
		"templates",
		"schemas",
		"README.md"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"sync:schemas": "node scripts/sync-content-schemas.mjs",
		"build": "tsc -p tsconfig.build.json",
		"test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
	},
	"dependencies": {
		"@biomejs/js-api": "6.1.0",
		"@biomejs/wasm-nodejs": "2.6.4",
		"@sf-kmods/kdataforgejs": "workspace:^",
		"typescript": ">=5.7.3 <6",
		"yaml": "^2.6.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.0"
	}
}
